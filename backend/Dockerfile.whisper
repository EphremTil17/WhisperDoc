# --- STAGE 0: FFmpeg Source ---
# We use a specialized static build to avoid 600MB of apt-dependencies
FROM mwader/static-ffmpeg:8.1 AS ffmpeg-source

# --- STAGE 1: Builder ---
FROM python:3.12-slim AS builder

WORKDIR /app
ENV UV_LINK_MODE=copy

# Native UV project install with a pinned toolchain
COPY --from=ghcr.io/astral-sh/uv:0.10.12 /uv /usr/local/bin/uv

# Install minimal build tools (gcc/g++ instead of the heavy build-essential)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy project metadata first so dependency layers stay cached across source changes
COPY pyproject.toml uv.lock ./

# Install only locked production dependencies before copying source
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --python /usr/local/bin/python3 --locked --no-dev --no-editable --extra whisper --no-install-project

# Copy backend source and install the project itself into the same venv
COPY . .

# We aggressively prune unnecessary files (.a, .pyc, etc) to prevent layer expansion
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --python /usr/local/bin/python3 --locked --no-dev --no-editable --extra whisper && \
    find /app/.venv -name "*.a" -delete && \
    find /app/.venv -name "__pycache__" -type d -exec rm -rf {} + && \
    find /app/.venv -name "*.pyc" -delete


# --- STAGE 2: Runner ---
FROM python:3.12-slim AS runner

WORKDIR /app

# 1. Environment & Performance Settings
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/app/model-cache
ENV VIRTUAL_ENV=/app/.venv
ENV PATH=/app/.venv/bin:$PATH
# added the "Belt & Suspenders" environment variables ensures that any underlying C-libraries used by PyTorch or FFmpeg will also default to the RAM-disk at /tmp.
ENV TMPDIR=/tmp
ENV TEMP=/tmp
ENV TMP=/tmp

# The "Secret Sauce": Tell the system where the CUDA libs are hidden in Python site-packages
ENV LD_LIBRARY_PATH=/app/.venv/lib/python3.12/site-packages/nvidia/cublas/lib:/app/.venv/lib/python3.12/site-packages/nvidia/cudnn/lib:$LD_LIBRARY_PATH

# 2. Install ONLY runtime essentials (libgomp1 is required for Whisper's math)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 3. Copy static FFmpeg binaries from Stage 0
COPY --from=ffmpeg-source /ffmpeg /ffprobe /usr/local/bin/

# 4. Copy the UV-managed virtual environment from the builder stage
COPY --from=builder /app/.venv /app/.venv

# 6. Network & Execution
ARG API_PORT=9989
ENV API_PORT=${API_PORT}
EXPOSE ${API_PORT}

# Bake version into the image metadata
ARG VERSION
LABEL version=${VERSION}

# Use Python for healthcheck to avoid installing curl
HEALTHCHECK --interval=10m --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:${API_PORT}/health')" || exit 1

# Exec form wrapping sh -c to preserve env var expansion (${API_PORT}).
# The shell expands ${API_PORT}, then exec replaces it so uvicorn becomes PID 1.
CMD ["sh", "-c", "exec python -m uvicorn api_server:app --host 0.0.0.0 --port ${API_PORT} --ws websockets-sansio --proxy-headers --forwarded-allow-ips='*' --ws-max-size 1048576 --timeout-keep-alive 60"]
