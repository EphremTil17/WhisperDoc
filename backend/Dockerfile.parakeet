# ============================================================
# WhisperDoc — Parakeet Backend (Slim)
# NVIDIA NeMo parakeet-tdt-0.6b-v2 (English-only TDT ASR)
# ============================================================
# Same multi-stage pattern as Dockerfile.whisper.
# Installs nemo_toolkit[asr] via uv on a slim base instead of
# pulling the 15GB nvcr.io/nvidia/nemo research container.

# --- STAGE 0: FFmpeg Source ---
FROM mwader/static-ffmpeg:latest AS ffmpeg-source

# --- STAGE 1: Builder ---
FROM python:3.12-slim AS builder

WORKDIR /app

# uv: 10-50x faster dependency resolution and installation vs pip
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# NeMo ASR needs build tools + libsndfile for soundfile
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    python3-dev \
    libsndfile1-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements (shared base + parakeet-specific)
COPY requirements.txt requirements_parakeet.txt ./

# NOTE: Unlike Dockerfile.whisper, we keep __pycache__ and .pyc files intact.
# NeMo's dependency chain (librosa → numba) uses JIT compilation and requires
# numba's file locator to resolve source paths via __pycache__ entries.
# Pruning them causes: "no locator available for file '...librosa/core/notation.py'"
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /usr/local/bin/python3 --target /root/.local/lib/python3.12/site-packages \
    -r requirements.txt -r requirements_parakeet.txt && \
    find /root/.local -name "*.a" -delete

# --- STAGE 2: Runner ---
FROM python:3.12-slim AS runner

WORKDIR /app

# Environment & Performance
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV LHOTSE_LOGGING_LEVEL=ERROR
ENV HF_HOME=/app/model-cache
ENV PATH=/root/.local/bin:$PATH
ENV PYTHONPATH=/root/.local/lib/python3.12/site-packages:$PYTHONPATH
ENV TMPDIR=/tmp
ENV TEMP=/tmp
ENV TMP=/tmp

# NeMo/PyTorch CUDA libs from site-packages
ENV LD_LIBRARY_PATH=/root/.local/lib/python3.12/site-packages/nvidia/cublas/lib:/root/.local/lib/python3.12/site-packages/nvidia/cudnn/lib:$LD_LIBRARY_PATH

# Runtime: libgomp for torch, libsndfile for soundfile/NeMo audio I/O
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libsndfile1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Static FFmpeg
COPY --from=ffmpeg-source /ffmpeg /ffprobe /usr/local/bin/

# Dependencies from builder
COPY --from=builder /root/.local /root/.local

# Application code
COPY . .

# Network & Execution
ARG API_PORT=9989
ENV API_PORT=${API_PORT}
EXPOSE ${API_PORT}

ARG VERSION
LABEL version=${VERSION}

HEALTHCHECK --interval=10m --timeout=10s --start-period=10s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:${API_PORT}/health')" || exit 1

# python3 -m uvicorn: --target installs don't create bin/ scripts, so we
# invoke uvicorn as a module which always works via PYTHONPATH.
CMD python3 -m uvicorn api_server:app \
    --host 0.0.0.0 \
    --port ${API_PORT} \
    --ws websockets-sansio \
    --proxy-headers \
    --forwarded-allow-ips='*' \
    --ws-max-size 1048576 \
    --timeout-keep-alive 60
