# ============================================================
# WhisperDoc — Parakeet Backend (Slim)
# NVIDIA NeMo parakeet-tdt-0.6b-v2 (English-only TDT ASR)
# ============================================================
# Same multi-stage pattern as Dockerfile.whisper.
# Installs nemo_toolkit[asr] via uv on a slim base instead of
# pulling the 15GB nvcr.io/nvidia/nemo research container.

# --- STAGE 0: FFmpeg Source ---
FROM mwader/static-ffmpeg:latest AS ffmpeg-source

# --- STAGE 1: Builder ---
FROM python:3.12-slim AS builder

WORKDIR /app
ENV UV_LINK_MODE=copy

# Native UV project install with a pinned toolchain
COPY --from=ghcr.io/astral-sh/uv:0.10.12 /uv /usr/local/bin/uv

# NeMo ASR needs build tools + libsndfile for soundfile
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    python3-dev \
    libsndfile1-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy project metadata first so dependency layers stay cached across source changes
COPY pyproject.toml uv.lock ./

# NOTE: Unlike Dockerfile.whisper, we keep __pycache__ and .pyc files intact.
# NeMo's dependency chain (librosa → numba) uses JIT compilation and requires
# numba's file locator to resolve source paths via __pycache__ entries.
# Pruning them causes: "no locator available for file '...librosa/core/notation.py'"
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --python /usr/local/bin/python3 --locked --no-dev --no-editable --extra parakeet --no-install-project

# Copy backend source and install the project itself into the same venv.
COPY . .

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --python /usr/local/bin/python3 --locked --no-dev --no-editable --extra parakeet && \
    find /app/.venv -name "*.a" -delete

# --- STAGE 2: Runner ---
FROM python:3.12-slim AS runner

WORKDIR /app

# Environment & Performance
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV LHOTSE_LOGGING_LEVEL=ERROR
ENV HF_HOME=/app/model-cache
ENV VIRTUAL_ENV=/app/.venv
ENV PATH=/app/.venv/bin:$PATH
ENV TMPDIR=/tmp
ENV TEMP=/tmp
ENV TMP=/tmp

# NeMo/PyTorch CUDA libs from site-packages
ENV LD_LIBRARY_PATH=/app/.venv/lib/python3.12/site-packages/nvidia/cublas/lib:/app/.venv/lib/python3.12/site-packages/nvidia/cudnn/lib:$LD_LIBRARY_PATH

# Runtime: libgomp for torch, libsndfile for soundfile/NeMo audio I/O
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libsndfile1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Static FFmpeg
COPY --from=ffmpeg-source /ffmpeg /ffprobe /usr/local/bin/

# Dependencies from builder
COPY --from=builder /app/.venv /app/.venv

# Network & Execution
ARG API_PORT=9989
ENV API_PORT=${API_PORT}
EXPOSE ${API_PORT}

ARG VERSION
LABEL version=${VERSION}

HEALTHCHECK --interval=10m --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:${API_PORT}/health')" || exit 1

# python -m uvicorn runs from the UV-managed project environment.
CMD python -m uvicorn api_server:app \
    --host 0.0.0.0 \
    --port ${API_PORT} \
    --ws websockets-sansio \
    --proxy-headers \
    --forwarded-allow-ips='*' \
    --ws-max-size 1048576 \
    --timeout-keep-alive 60
