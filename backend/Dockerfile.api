# Lightweight API image for externally hosted ASR engines such as parakeet.cpp.
FROM mwader/static-ffmpeg:8.1 AS ffmpeg-source

FROM python:3.12-slim AS builder

WORKDIR /app
ENV UV_LINK_MODE=copy

COPY --from=ghcr.io/astral-sh/uv:0.10.12 /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --python /usr/local/bin/python3 --locked --no-dev --no-editable --no-install-project

COPY . .

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --python /usr/local/bin/python3 --locked --no-dev --no-editable && \
    find /app/.venv -name "*.a" -delete && \
    find /app/.venv -name "__pycache__" -type d -exec rm -rf {} + && \
    find /app/.venv -name "*.pyc" -delete

FROM python:3.12-slim AS runner

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/app/.venv \
    PATH=/app/.venv/bin:$PATH \
    TMPDIR=/tmp \
    TEMP=/tmp \
    TMP=/tmp

COPY --from=ffmpeg-source /ffmpeg /ffprobe /usr/local/bin/
COPY --from=builder /app/.venv /app/.venv

ARG API_PORT=9989
ENV API_PORT=${API_PORT}
EXPOSE ${API_PORT}

ARG VERSION
LABEL version=${VERSION}

HEALTHCHECK --interval=10m --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:${API_PORT}/health')" || exit 1

CMD ["sh", "-c", "exec python -m uvicorn api_server:app --host 0.0.0.0 --port ${API_PORT} --ws websockets-sansio --proxy-headers --forwarded-allow-ips='*' --ws-max-size 1048576 --timeout-keep-alive 60"]
