# WhisperDoc Environment Configuration Template
# Copy this file to .env and customize the values for your setup

# API Server Configuration
API_PORT=9989
API_HOST=0.0.0.0

# CUDA Configuration
CUDA_VISIBLE_DEVICES=0

# Model Configuration
MODEL_NAME=medium.en
MODEL_DEVICE=cuda
MODEL_COMPUTE_TYPE=float16

# Logging Configuration
LOG_LEVEL=INFO

# Application Version (Single Source of Truth)
WHISPER_DOC_VERSION=2.6.1

# Security - Authentication Configuration
# Door #1: Static API Key (Python terminal client, admin access)
WHISPER_DOC_API_KEY=""

# Door #2: OIDC/JWT Tokens (Flutter client, production users)
# Leave OIDC_ISSUER_URL empty to disable OIDC authentication
# Example: https://auth.yourdomain.com/application/o/whisperdoc/
OIDC_ISSUER_URL=
# The OAuth2 Client ID (audience) expected in tokens
OIDC_CLIENT_ID=whisperdoc_client
# JWKS cache duration in seconds (default: 1 hour)
OIDC_JWKS_CACHE_SECONDS=3600
