# WhisperDoc Environment Configuration Template
# Copy this file to .env and customize the values for your setup

# API Server Configuration
API_PORT=9989
API_HOST=0.0.0.0
# Security Hardening: Allowed hosts and CORS origins (comma separated)
ALLOWED_HOSTS=*
ALLOWED_ORIGINS=*

# CUDA Configuration
CUDA_VISIBLE_DEVICES=0

# Model Configuration
MODEL_NAME=medium.en
MODEL_DEVICE=cuda
MODEL_COMPUTE_TYPE=float16

# Whisper Performance & Hallucination Control
# -----------------------------------------------------------------------------
# BEAM_SIZE: Number of search paths. 1 = Greedy Search (Fastest, recommended for low latency).
WHISPER_BEAM_SIZE=3
# NO_SPEECH_THRESHOLD: Probability threshold (0.0 to 1.0). 
# If Whisper is more than this % sure there is silence, it returns an empty string.
# Higher = More aggressive silence removal (kills "Thank you" hallucinations).
WHISPER_NO_SPEECH_THRESHOLD=0.6
# LOG_PROB_THRESHOLD: Average log probability of the tokens.
# If lower than this, the entire transcription is rejected. -1.0 is default.
WHISPER_LOG_PROB_THRESHOLD=-1.0
# CONDITION_ON_PREVIOUS: Whether to use previous text as context for the next segment.
# Set to 'true' for maximum accuracy (the "magic" effect where it knows the topic).
# Set to 'false' ONLY if you experience persistent repetitive hallucinations.
WHISPER_CONDITION_ON_PREVIOUS=true

# Logging Configuration
LOG_LEVEL=INFO
# Should logs be colorized (use 'false' for plain text log files)
COLORIZE_LOGS=true

# Application Version (Single Source of Truth)
WHISPER_DOC_VERSION=2.22.2
# Minimum required client version to allow connection
MIN_CLIENT_VERSION=0.0.0
# Recommended client version for security and stability (triggers advisory update)
SEC_CLIENT_VERSION=0.0.0

# Security - Authentication Configuration
# Door #1: Static API Key (Python terminal client, admin access)
WHISPER_DOC_API_KEY=""

# OIDC Configuration (Zitadel, Keycloak, etc.)
# -----------------------------------------------------------------------------
OIDC_ISSUER_URL=
# Example: https://<your-instance>.zitadel.cloud or https://<your-oidc-provider>/oidc
OIDC_CLIENT_ID=<your-client-id>
OIDC_API_RESOURCE=<your-client-id>  # For Zitadel, use Client ID as the audience
OIDC_JWKS_CACHE_SECONDS=3600

# Security Hardening - Anti-Spam & Health
MAX_BUFFER_SIZE=9600000
MAX_CONNECTIONS=10
IDLE_TIMEOUT_SECONDS=300
MODEL_TIMEOUT_SECONDS=1800
HANDSHAKE_TIMEOUT_SECONDS=15
BAN_FAILURE_THRESHOLD=5
BAN_FAILURE_WINDOW_SECONDS=60
BAN_DURATION_SECONDS=300
FLOOD_ATTEMPT_THRESHOLD=50
FLOOD_ATTEMPT_WINDOW_SECONDS=60
FLOOD_BAN_SECONDS=60
