# WhisperDoc Environment Configuration Template
# Copy this file to .env and customize the values for your setup

# API Server Configuration
API_PORT=9989
API_HOST=0.0.0.0
# Security Hardening: Allowed hosts and CORS origins (comma separated)
ALLOWED_HOSTS=*
ALLOWED_ORIGINS=*

# CUDA Configuration
CUDA_VISIBLE_DEVICES=0

# Engine Selection
# 'whisper'  -> faster-whisper (CTranslate2), port 9989
# 'parakeet' -> NVIDIA NeMo parakeet-tdt-0.6b-v2 (English-only), port 9990
ASR_ENGINE=whisper

# Whisper Model Configuration
MODEL_NAME=large-v3-turbo
MODEL_DEVICE=cuda
MODEL_COMPUTE_TYPE=float16

# Parakeet Model Configuration (used when ASR_ENGINE=parakeet)
# -----------------------------------------------------------------------------
# Default: parakeet-tdt-0.6b-v2 — best accuracy-per-VRAM on the Open ASR
# Leaderboard (avg WER 6.05, ~1.5GB VRAM, 3386x RTFx).
#
# Why v2 over v3: v3 scores worse on every benchmark except Gigaspeech and
# Tedlium (avg WER 6.32 vs 6.05). v2 wins on real-world datasets (AMI,
# Earnings22, SPGISpeech) which matter most for microphone dictation.
#
# Why 0.6b over 1.1b: the 1.1b model scores WORSE overall (avg WER 7.01)
# because it overfits to clean studio speech (LibriSpeech) at the expense of
# conversational/real-world audio. 0.6b generalises better.
#
# Upgrade paths (if VRAM allows):
#   nvidia/parakeet-tdt-0.6b-v3   — marginal trade-off (better on TED talks /
#                                    diverse web audio, worse elsewhere)
#   nvidia/canary-qwen-2.5b        — next meaningful accuracy jump (WER 5.63,
#                                    ~5GB VRAM, still NeMo-based, one-line swap)
PARAKEET_MODEL_NAME=nvidia/parakeet-tdt-0.6b-v2
PARAKEET_DEVICE=cuda
PARAKEET_SUPPRESS_STDIO=true
PARAKEET_PORT=9990

# Whisper Performance & Hallucination Control
# -----------------------------------------------------------------------------
# BEAM_SIZE: Number of search paths. 1 = Greedy Search (Fastest, recommended for low latency).
WHISPER_BEAM_SIZE=3
# NO_SPEECH_THRESHOLD: Probability threshold (0.0 to 1.0). 
# If Whisper is more than this % sure there is silence, it returns an empty string.
# Higher = More aggressive silence removal (kills "Thank you" hallucinations).
WHISPER_NO_SPEECH_THRESHOLD=0.6
# LOG_PROB_THRESHOLD: Average log probability of the tokens.
# If lower than this, the entire transcription is rejected. -1.0 is default.
WHISPER_LOG_PROB_THRESHOLD=-1.0
# CONDITION_ON_PREVIOUS: Whether to use previous text as context for the next segment.
# Set to 'true' for maximum accuracy (the "magic" effect where it knows the topic).
# Set to 'false' ONLY if you experience persistent repetitive hallucinations.
WHISPER_CONDITION_ON_PREVIOUS=true

# Logging Configuration
LOG_LEVEL=INFO
# Should logs be colorized (use 'false' for plain text log files)
COLORIZE_LOGS=true

# Application Version (Single Source of Truth)
WHISPER_DOC_VERSION=2.23.2
# Minimum required client version to allow connection
MIN_CLIENT_VERSION=0.0.0
# Recommended client version for security and stability (triggers advisory update)
SEC_CLIENT_VERSION=0.0.0

# Security - Authentication Configuration
# Door #1: Static API Key (Python terminal client, admin access)
WHISPER_DOC_API_KEY=""

# OIDC Configuration (Zitadel, Keycloak, etc.)
# -----------------------------------------------------------------------------
OIDC_ISSUER_URL=
# Example: https://<your-instance>.zitadel.cloud or https://<your-oidc-provider>/oidc
OIDC_CLIENT_ID=<your-client-id>
OIDC_API_RESOURCE=<your-client-id>  # For Zitadel, use Client ID as the audience
OIDC_JWKS_CACHE_SECONDS=3600

# Security Hardening - Anti-Spam & Health
# MAX_BUFFER_SIZE: Max bytes accumulated in a session's audio buffer (~9.6 MB). Prevents runaway memory growth from clients that never stop streaming.
MAX_BUFFER_SIZE=9600000
# MAX_CONNECTIONS: Maximum number of simultaneous WebSocket connections. Basic protection against connection exhaustion.
MAX_CONNECTIONS=10
# IDLE_TIMEOUT_SECONDS: Seconds of inactivity before an idle client is disconnected. Frees resources from abandoned sessions.
IDLE_TIMEOUT_SECONDS=300
# NO_AUDIO_GRACE_SECONDS: Seconds an authenticated connection may stay open without sending any audio before being evicted. Catches clients that connect and hold a slot without ever recording.
NO_AUDIO_GRACE_SECONDS=120
# MODEL_TIMEOUT_SECONDS: Maximum total session duration in seconds. Prevents a single client from holding the model indefinitely.
MODEL_TIMEOUT_SECONDS=1800
# HANDSHAKE_TIMEOUT_SECONDS: Seconds the server waits for a client to complete the WebSocket handshake and authenticate.
HANDSHAKE_TIMEOUT_SECONDS=15
# BAN_FAILURE_THRESHOLD: Number of auth failures (bad API key / token) allowed before the client IP is temporarily banned.
BAN_FAILURE_THRESHOLD=5
# BAN_FAILURE_WINDOW_SECONDS: Rolling time window (seconds) in which auth failures are counted toward the ban threshold.
BAN_FAILURE_WINDOW_SECONDS=60
# BAN_DURATION_SECONDS: How long (seconds) a banned IP is blocked after exceeding the auth failure threshold.
BAN_DURATION_SECONDS=300
# FLOOD_ATTEMPT_THRESHOLD: Number of connection attempts from one IP within the window before it is considered flooding.
FLOOD_ATTEMPT_THRESHOLD=50
# FLOOD_ATTEMPT_WINDOW_SECONDS: Rolling time window (seconds) in which connection attempts are counted toward the flood threshold.
FLOOD_ATTEMPT_WINDOW_SECONDS=60
# FLOOD_BAN_SECONDS: How long (seconds) a flooding IP is blocked after exceeding the connection attempt threshold.
FLOOD_BAN_SECONDS=60
