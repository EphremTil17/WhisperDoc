# Ignore virtual environments
venv/
.venv/
env/

# Ignore local model caches (Docker uses volumes)
model-cache/
**/model-cache/

# Ignore Python artifacts
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Ignore IDE settings
.vscode/
.idea/

# Ignore Git
.git/
.gitignore

# Ignore logs
*.log
logs/

# Ignore secrets/local config
.env

# Ignore Docker related files in context
Dockerfile
docker-compose*.yml
.dockerignore

# Ignore documentation/meta
*.md
LICENSE
