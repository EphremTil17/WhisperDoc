# Byte-compiled / cache files
__pycache__/
*.py[cod]
*.so
*.pyc  

# Virtual environments
**/venv
**/.venv
**/.env

# Environment configuration (keep .env.example)
**/.env

# Logs and temp files
*.log
**/logs/
*.tmp
.coverage
.coverage.*
.pytest_cache/
.pyright/
*.egg-info/

# Large audio files (test recordings, samples)
# Small UI assets (flutter_client/assets/audio/) are tracked intentionally.
assets/*.wav
assets/*.mp3
assets/*.m4a
assets/*.ogg

# OS-specific
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# Docker
node_modules
package-lock.json
model-cache/
package.json
terminal.txt
.specify/*
.gemini/*
specs/
PROJECT_CONTEXT.md
flutter_client/env.json
# Inno Setup output; release installers are built by CI as GitHub Release assets
flutter_client/windows/installer/*.exe
win_x64_release/*.exe

# Design tooling scratch: Playwright logs, impeccable decision mocks, review
# captures and caches. The durable impeccable records (surfaces/, config.json)
# and PRODUCT.md are tracked.
.playwright-mcp/
.impeccable/mocks/
.impeccable/review/
.impeccable/questions/
.impeccable/hook.cache.json
.impeccable/decision-*.json
.impeccable/brief-*.md
